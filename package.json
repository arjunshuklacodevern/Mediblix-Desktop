{
  "name": "mediblix-desktop",
  "version": "1.0.0",
  "description": "Mediblix Pharmacy Management System — Desktop Application",
  "main": "electron/main.js",
  "author": "Mediblix",
  "license": "ISC",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin-frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin-frontend",
    "build:all": "npm run build:frontend && npm run build:admin",
    "electron:dev": "node electron/runner.js .",
    "electron:prod": "node electron/runner.js . --production",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:admin\" \"wait-on http-get://localhost:5173 http-get://localhost:5174 && npm run electron:dev\"",
    "start": "npm run build:all && npm run electron:prod",
    "test:db": "node database/tests/test_database.js && node database/tests/test_repositories.js",
    "test:api": "node backend/tests/test_auth_and_products.js",
    "test:pos": "node backend/tests/test_customers_and_sales.js",
    "test:orders": "node backend/tests/test_suppliers_and_orders.js",
    "test:admin": "node backend/tests/test_admin_and_ai.js",
    "test:jwt": "node backend/tests/test_jwt_secret_persistence.js",
    "test:offline": "node backend/tests/test_offline_and_mongo_removal.js",
    "test:supervisor": "node electron/tests/test_backend_supervisor.js",
    "test:firstrun": "node electron/tests/test_first_run_notice.js && node backend/tests/test_first_run_provisioning.js",
    "test:localai": "node electron/tests/test_local_ai_supervisor.js",
    "test:hardware": "node electron/tests/test_hardware_profile.js",
    "test:liveai": "node backend/tests/test_local_ai_live.js",
    "test:aiint": "node electron/tests/test_local_ai_integration.js",
    "test:ai": "node backend/tests/test_ai_online_offline.js",
    "test:sync": "node electron/tests/test_device_auth.js && node electron/tests/test_bidirectional_sync.js && node electron/tests/test_scheduler.js",
    "test": "npm run test:db && npm run test:jwt && npm run test:api && npm run test:pos && npm run test:orders && npm run test:admin && npm run test:offline && npm run test:supervisor && npm run test:sync && npm run test:firstrun && npm run test:localai && npm run test:hardware && npm run test:aiint && npm run test:ai",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.mediblix.desktop",
    "productName": "Mediblix",
    "copyright": "Copyright © 2026 Mediblix",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/audit_reports/**",
      "!electron/tests/**",
      "!electron/run_comprehensive_audit.js",
      "!electron/test_safe_dev_gui.js",
      "database/**/*",
      "!database/tests/**",
      "!**/*.db*",
      "!**/*.log",
      "!**/.env*",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build/bin/node.exe",
        "to": "bin/node.exe"
      },
      {
        "from": "electron/ai-catalog.js",
        "to": "electron/ai-catalog.js"
      },
      {
        "from": "electron/ai-model-catalog.json",
        "to": "electron/ai-model-catalog.json"
      },
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!_downloads/**"
        ]
      },
      {
        "from": "electron/sync",
        "to": "electron/sync",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests/**",
          "!**/*.db*",
          "!**/*.log",
          "!**/.env*"
        ]
      },
      {
        "from": "database",
        "to": "database",
        "filter": [
          "**/*",
          "!tests/**",
          "!**/*.db*",
          "!**/*.log",
          "!**/.env*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend-dist",
        "filter": ["**/*"]
      },
      {
        "from": "admin-frontend/dist",
        "to": "admin-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
